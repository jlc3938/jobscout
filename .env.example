# Copy to .env (git-ignored) and fill in. Used by `python jobscout.py digest`.
# Gmail needs an app password: Google Account > Security > 2-Step Verification > App passwords.
JOBSCOUT_EMAIL_FROM=you@gmail.com
JOBSCOUT_SMTP_PASSWORD=abcdefghijklmnop
# Optional: send somewhere other than JOBSCOUT_EMAIL_FROM
# JOBSCOUT_EMAIL_TO=you@example.com
# ANTHROPIC_API_KEY=sk-ant-...   (for `score`; not read from .env yet, export it instead)
